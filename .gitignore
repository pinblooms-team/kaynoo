# Magento 2 project (composer install restores core files)
# app/etc/config.php stays tracked so the enabled-module list can be committed.
# app/etc/env.php stays ignored because it holds database credentials.

# IDE and OS
/.buildpath
/.cache
/.metadata
/.project
/.settings
/.vscode
/.idea
atlassian*
/nbproject
.DS_Store
Thumbs.db

# Secrets
/auth.json
/app/etc/env.php
*.pem
*.key

# Database dumps and archives anywhere in the project
*.sql
*.sql.gz
*.zip
/*.tar
/*.tar.gz
/*.tgz
*.rej

# Restored by composer install (magento-composer-installer)
/bin/
/dev/
/lib/
/setup/
/phpserver/
/update/
/vendor/

# Generated at runtime
/generated/
/var/

# Published files, uploads, and local tools
/pub/static/**
!/pub/static/.htaccess
/pub/media/**
!/pub/media/.htaccess
/pub/opt/
/pub/pma_db/
/pub/robots.txt
/pub/*sitemap*
/robots.txt
/sitemap
/sitemap.xml

# Local helpers and stock server sample (not used by Magento itself)
/mutagen.sh
/permit.sh
/nginx.conf
/package.json
/package-lock.json

# Frontend tooling
/node_modules
/.grunt
/Gruntfile.js
/grunt-config.json

# PHP tooling caches
/.php_cs
/.php_cs.cache
/.php-cs-fixer.php
/.php-cs-fixer.cache
/.phpunit.result.cache
/phpunit.xml
/app/config_sandbox
/app/code/Magento/TestModule*
