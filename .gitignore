# Magento 2 project (composer install restores core files)
# app/etc/config.php stays tracked so the enabled-module list can be committed.
# app/etc/env.php stays ignored because it holds database credentials.

# IDE and OS
/.buildpath
/.cache
/.metadata
/.project
/.settings
/.vscode
/.idea
/.editorconfig
atlassian*
/nbproject
.DS_Store
Thumbs.db

# Secrets and local env
/auth.json
/auth.json.sample
/app/etc/env.php
/.docker-services.env
/.user.ini
/php.dev.ini
*.pem
*.key

# Database dumps and archives anywhere in the project
*.sql
*.sql.gz
*.zip
/*.tar
/*.tar.gz
/*.tgz
*.rej
/composer.lock-old

# Restored by composer install (magento/project-community-edition)
/.htaccess
/.htaccess.sample
/.php-cs-fixer.dist.php
/CHANGELOG.md
/COPYING.txt
/LICENSE.txt
/LICENSE_AFL.txt
/SECURITY.md
/Gruntfile.js.sample
/grunt-config.json.sample
/nginx.conf.sample
/package.json.sample
/bin/
/dev/
/lib/
/setup/
/phpserver/
/update/
/vendor/

# Generated at runtime
/generated/
/var/

# Published files, uploads, and local tools
/pub/static/
/pub/media/
/pub/errors/local.xml.sample
/pub/opt/
/pub/pma_db/
/pub/robots.txt
/pub/*sitemap*
/robots.txt
/sitemap
/sitemap.xml

# Local helpers, Docker leftovers, stock Magento samples
/mutagen.sh
/permit.sh
/nginx.conf
/package.json
/package-lock.json
/.docker/
/docker/
/docker-compose.yml
/docker-sync.yml

# Frontend tooling
/node_modules
/.grunt
/Gruntfile.js
/grunt-config.json

# PHP tooling caches
/.php_cs
/.php_cs.cache
/.php-cs-fixer.php
/.php-cs-fixer.cache
/.phpunit.result.cache
/phpunit.xml
/app/config_sandbox
/app/code/Magento/TestModule*
