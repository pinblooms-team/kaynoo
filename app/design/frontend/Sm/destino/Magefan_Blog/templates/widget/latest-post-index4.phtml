<?php
/**
 * Blog recent posts widget
 *
 * @var $block \Magefan\Blog\Block\Widget\Recent
 */
?>

<?php
$_postCollection = $block->getPostCollection();

$_config           = $this->helper('Sm\Destino\Helper\Data');
$enableLadyLoading = $_config->getAdvanced('enable_ladyloading');
$mediaSrc          = $_config->getMediaUrl();
if ($enableLadyLoading) {
	$imgClass = 'lazyload';
} else {
	$imgClass = '';
}
?>
<?php if ($_postCollection->count()) { ?>
    <div class="post-list-wrapper blog-widget-recent">
	<div class="title-block-primary">
		<h2><?php echo $block->escapeHtml($block->getTitle()) ?></h2>
	</div>
	
	<p class="short-description-block">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor<br>incididunt ut labore et dolore magna aliqua.</p>
	
    <div class="slider-post-dots">
        <?php foreach ($_postCollection as $_post) { ?>
			<?php
			$_postUrl  = $_post->getPostUrl();
			$_postName = $block->escapeHtml($_post->getTitle(), null, true);
			?>
            <div class="item">
				<div class="item-post">
					<div class="featured-image">
						<?php if ($featuredImage = $_post->getFeaturedImage()) { ?>
                            <a title="<?php echo $_postName; ?>" href="<?php echo $_postUrl ?>">
								<img class="<?php echo $imgClass; ?>"
									<?php if ($enableLadyLoading) { ?>
                                        src="<?php echo $mediaSrc . 'lazyloading/blank.png'; ?>"
                                        data-src="<?php echo $featuredImage ?>"
									<?php } else { ?>
                                        src="<?php echo $featuredImage ?>"
									<?php } ?>

                                     alt="<?php echo $_postName ?>"
                                />
							</a>
						<?php } else { ?>
                            <a title="<?php echo $_postName; ?>" href="<?php echo $_postUrl ?>">
								<img src="<?php /* @escapeNotVerified */
								echo $block->getViewFileUrl('images/post/no_image.jpg') ?>" alt="<?php echo $_postName ?>"/>
							</a>
						<?php } ?>
					</div>
					
					<div class="post-info">
						<div class="date-post">
							<?php
							$date_post = $_post->getPublishDate('Y-m-d');
							$day       = date('d', strtotime($date_post));
							$month     = date('F', strtotime($date_post));
							$year      = date('Y', strtotime($date_post));
							?>

                            <div class="day-post"><?php echo $day; ?></div>
							<div class="month-post"><?php echo $month . ', ' . $year; ?></div>
						</div>
						
						<h3>
							<a class="post-item-link" href="<?php echo $_postUrl ?>"> <?php echo $_postName; ?></a>
						</h3>
						
						<div class="short-content">
							<?php
							$short_text = strip_tags($block->getShorContent($_post));
							echo substr($short_text, 0, 75);
							?>
						</div>
						
						<a class="more-post" href="<?php echo $_postUrl ?>" title="<?php echo __('View more'); ?>"><?php echo __('View more'); ?></a>
					</div>
				</div>
            </div>
		<?php } ?>
    </div>
</div>
<?php } ?>