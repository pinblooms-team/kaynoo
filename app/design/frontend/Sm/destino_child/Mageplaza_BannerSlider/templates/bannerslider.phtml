use Mageplaza\BannerSlider\Model\Config\Source\Type;

$banners = $block->getBannerCollection();
$check   = is_array($banners) ? !empty($banners) : $banners->getSize();
if ($check) : ?>
    <?php
    $sliderId      = $block->getSliderId() . uniqid('-', false);
    $sliderOptions = $block->getBannerOptions(); ?>
    <div class="carousel-container mp-banner-slider">
        <div id="banner-slider-carousel">
            <?php $iterator = 1; ?>
            <div id="bannerslider-list-items-<?= /* @noEscape */ $sliderId ?>" class="owl-carousel owl-theme">
                <?php foreach ($banners as $banner) : ?>
                    <?php
                    $bnType  = $banner->getType();
                    $bnTitle = $banner->getTitle();
                    $bnUrl   = $banner->getUrlBanner();
                    $bnImg   = $banner->getImageUrl();
                    // Define different sizes of the image if available
                    $bnImgSrcset = [
                        '420w' => $block->escapeUrl($bnImg),
                        '840w' => $block->escapeUrl($bnImg) // Replace with URL for larger size
                    ];
                    ?>
                    <?php if (($bnType === Type::CONTENT && empty($banner->getContent())) || ($bnType === Type::IMAGE && empty($banner->getImage()))) : continue; ?>
                    <?php endif; ?>
                    <?= ($iterator++ === 1) ? '<div class="banner-item banner-slider">' : '</div><div class="banner-item banner-slider">' ?>
                    <?php if ($bnType === Type::CONTENT) : ?>
                        <div class="item-content">
                            <?= /* @noEscape */ $block->getPageFilter($banner->getContent()) ?>
                        </div>
                    <?php else : #image type 
                    ?>
                        <div class="item-image">
                            <?php if (!empty($bnUrl)) : ?>
                                <a class="owl-image" href="<?= $block->escapeUrl($bnUrl) ?>" <?= /* @noEscape */ ($banner->getNewtab() === '1') ? 'target="_blank"' : '' ?>>
                                    <?php if ($iterator === 2) : ?>
                                        <img class="img-responsive"
                                            src="<?= $block->escapeUrl($bnImg) ?>"
                                            srcset="
                                               <?= implode(', ', array_map(
                                                    fn($width, $url) => "{$url} {$width}",
                                                    array_keys($bnImgSrcset),
                                                    $bnImgSrcset
                                                )) ?>"
                                            sizes="(max-width: 420px) 100vw, 420px"
                                            alt="<?= $block->escapeHtml($bnTitle) ?>"
                                            width="420"
                                            height="194">
                                    <?php else : ?>
                                        <?php if ($block->isLazyLoad()) : ?>
                                            <img class="img-responsive owl-lazy"
                                                data-src-retina="<?= $block->escapeUrl($bnImg) ?>"
                                                data-src="<?= $block->escapeUrl($bnImg) ?>"
                                                srcset="
                                                   <?= implode(', ', array_map(
                                                        fn($width, $url) => "{$url} {$width}",
                                                        array_keys($bnImgSrcset),
                                                        $bnImgSrcset
                                                    )) ?>"
                                                sizes="(max-width: 420px) 100vw, 420px"
                                                alt="<?= $block->escapeHtml($bnTitle) ?>"
                                                width="420"
                                                height="194"
                                                loading="lazy">
                                        <?php else : ?>
                                            <img class="img-responsive"
                                                src="<?= $block->escapeUrl($bnImg) ?>"
                                                srcset="
                                                   <?= implode(', ', array_map(
                                                        fn($width, $url) => "{$url} {$width}",
                                                        array_keys($bnImgSrcset),
                                                        $bnImgSrcset
                                                    )) ?>"
                                                sizes="(max-width: 420px) 100vw, 420px"
                                                alt="<?= $block->escapeHtml($bnTitle) ?>"
                                                width="420"
                                                height="194"
                                                loading="lazy">
                                        <?php endif; ?>
                                    <?php endif; ?>
                                </a>
                            <?php else : ?>
                                <?php if ($iterator === 2) : ?>
                                    <img class="owl-image img-responsive"
                                        src="<?= $block->escapeUrl($bnImg) ?>"
                                        srcset="
                                           <?= implode(', ', array_map(
                                                fn($width, $url) => "{$url} {$width}",
                                                array_keys($bnImgSrcset),
                                                $bnImgSrcset
                                            )) ?>"
                                        sizes="(max-width: 420px) 100vw, 420px"
                                        title="<?= $block->escapeHtml($bnTitle) ?>"
                                        alt="<?= $block->escapeHtml($bnTitle) ?>"
                                        width="420"
                                        height="194">
                                <?php else : ?>
                                    <?php if ($block->isLazyLoad()) : ?>
                                        <img class="owl-image img-responsive owl-lazy"
                                            data-src-retina="<?= $block->escapeUrl($bnImg) ?>"
                                            data-src="<?= $block->escapeUrl($bnImg) ?>"
                                            srcset="
                                               <?= implode(', ', array_map(
                                                    fn($width, $url) => "{$url} {$width}",
                                                    array_keys($bnImgSrcset),
                                                    $bnImgSrcset
                                                )) ?>"
                                            sizes="(max-width: 420px) 100vw, 420px"
                                            title="<?= $block->escapeHtml($bnTitle) ?>"
                                            alt="<?= $block->escapeHtml($bnTitle) ?>"
                                            width="420"
                                            height="194"
                                            loading="lazy">
                                    <?php else : ?>
                                        <img class="owl-image img-responsive"
                                            src="<?= $block->escapeUrl($bnImg) ?>"
                                            srcset="
                                               <?= implode(', ', array_map(
                                                    fn($width, $url) => "{$url} {$width}",
                                                    array_keys($bnImgSrcset),
                                                    $bnImgSrcset
                                                )) ?>"
                                            sizes="(max-width: 420px) 100vw, 420px"
                                            title="<?= $block->escapeHtml($bnTitle) ?>"
                                            alt="<?= $block->escapeHtml($bnTitle) ?>"
                                            width="420"
                                            height="194"
                                            loading="lazy">
                                    <?php endif; ?>
                                <?php endif; ?>
                            <?php endif; ?>
                        </div>
                    <?php endif; ?>
                    <?= ($iterator === count($banners) + 1) ? '</div>' : '' ?>
                <?php endforeach; ?>
            </div>
        </div>
        <?= $block->getPagerHtml() ?>
    </div>
    <script>
        require(['jquery', 'mageplaza/core/owl.carousel'], function($) {
            $('#bannerslider-list-items-<?= /* @noEscape */ $sliderId ?>').owlCarousel(<?= /* @noEscape */ $sliderOptions ?>);
            if (/Android|webOS|iPhone|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                var widthMb = parseFloat($('.page-wrapper').width()) - 30;
                $('.mp-banner-sidebar').attr('style', 'max-width: ' + widthMb + 'px');
            }
        });
    </script>
<?php endif; ?>