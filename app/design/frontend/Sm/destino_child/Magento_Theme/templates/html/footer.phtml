		<script type="text/javascript">
			require([
				'jquery'
			], function($) {
				$("#sm-totop").hide();
				$(function() {
					var wh = $(window).height();
					var whtml = $(document).height();
					$(window).scroll(function() {
						if ($(this).scrollTop() > whtml / 10) {
							$('#sm-totop').fadeIn();
						} else {
							$('#sm-totop').fadeOut();
						}
					});
					$('#sm-totop').click(function() {
						$('body,html').animate({
							scrollTop: 0
						}, 800);
						return false;
					});
				});
			});
		</script>
