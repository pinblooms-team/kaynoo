<?php
/** @var \Magento\Checkout\Model\Session $checkoutSession */
$checkoutSession = \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\Checkout\Model\Session::class);
$order = $checkoutSession->getLastRealOrder(); // Retrieve the last real order
$totalAmount = $order->getGrandTotal(); // Get the order's grand total

// Calculate the amount including the 1% fee
$amountWithFee = round($totalAmount * 1.01);
?>

