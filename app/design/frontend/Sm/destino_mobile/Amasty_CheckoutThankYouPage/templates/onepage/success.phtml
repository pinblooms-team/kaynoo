<script type="text/javascript">
    function redirectToWave() {
        var amountWithFee = <?php echo $amountWithFee; ?>; // The amount including the 1% fee
        var waveUrl = 'https://pay.wave.com/m/M_r_UjrChcJ9wN/c/sn/?amount=' + amountWithFee;
        window.location.href = waveUrl;  // Redirect to Wave payment page
    }

    document.getElementById("custom-button").addEventListener("click", redirectToWave);
    document.getElementById("custom-button2").addEventListener("click", redirectToWave);
</script>