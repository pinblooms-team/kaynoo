<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <pinblooms_checkout_guard>
            <general>
                <enabled>1</enabled>
                <enable_logging>1</enable_logging>
                <log_client_ip>1</log_client_ip>
                <log_user_agent>1</log_user_agent>
                <log_geo>1</log_geo>
            </general>
            <email>
                <block_disposable_guest_email>1</block_disposable_guest_email>
                <extended_email_patterns>1</extended_email_patterns>
                <block_gmail_plus_addressing>0</block_gmail_plus_addressing>
                <extra_blocked_domains></extra_blocked_domains>
            </email>
            <checkmo>
                <require_login_for_guests>1</require_login_for_guests>
            </checkmo>
            <guest_checkout>
                <enforce_magento_setting>1</enforce_magento_setting>
            </guest_checkout>
            <address>
                <block_template_injection>1</block_template_injection>
            </address>
            <rate_limit>
                <enabled>1</enabled>
                <max_attempts>25</max_attempts>
                <window_seconds>60</window_seconds>
                <max_attempts_per_cart>40</max_attempts_per_cart>
            </rate_limit>
            <payment_failed_email>
                <suppress_bot_emails>1</suppress_bot_emails>
                <skip_template_address>1</skip_template_address>
                <skip_zero_total>1</skip_zero_total>
                <skip_empty_guest_name>1</skip_empty_guest_name>
                <skip_junk_guest_email>1</skip_junk_guest_email>
            </payment_failed_email>
            <custom_option_file>
                <block_uploads>1</block_uploads>
            </custom_option_file>
        </pinblooms_checkout_guard>
    </default>
</config>
