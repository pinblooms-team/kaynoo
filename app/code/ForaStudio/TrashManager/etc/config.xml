<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <forastudio_trashmanager>
            <trashmanager>
                <enable>1</enable>
                <display_text>TrashManager</display_text>
            </trashmanager>
            <product>
            	<clear_after_days>7</clear_after_days>
            </product>
            <category>
            	<clear_after_days>7</clear_after_days>
            </category>
        </forastudio_trashmanager>
    </default>
</config>