        <plugin name="tecksky_custom_nextgen_html_replacer" type="Tecksky\Custom\Plugin\Yireo\HtmlReplacerPlugin"/>
    </type>
    <type name="Magefan\Blog\Model\Post">
        <plugin name="tecksky_custom_blog_short_content" type="Tecksky\Custom\Plugin\Blog\ShortContentPlugin"/>
    </type>
    <type name="Magento\Framework\App\View\Deployment\Version">
        <plugin name="tecksky_custom_trim_static_version" type="Tecksky\Custom\Plugin\View\DeploymentVersionPlugin"/>
